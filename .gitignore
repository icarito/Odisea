.gitignore: keep local generated imports out by default; CI requires imports present.
# Godot-specific ignores
export.cfg
# NOTE: CI requires Godot import metadata (.import/) to be present so headless runs can load resources.
# If you prefer to track import metadata for deterministic CI, remove/comment the following entries
# or commit the relevant .import files manually.
.import/*
*.import
!.import/
# Required import metadata for CI/runtime audio loading in PushableBoxV2.
!assets/sfx/metal1.wav.import
!assets/sfx/metal2.wav.import
!assets/sfx/metal3.wav.import
!.import/metal1.wav-*.md5
!.import/metal1.wav-*.sample
!.import/metal2.wav-*.md5
!.import/metal2.wav-*.sample
!.import/metal3.wav-*.md5
!.import/metal3.wav-*.sample
*.stex
.vscode/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Game specific
replays/
reports/

pupeteer/.venv/
*.pyc
*/__pycache__/
digest.txt
