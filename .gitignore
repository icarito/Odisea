experimental/
ports/
build/
maps/autosave/

# Godot-specific ignores
export.cfg
# Android debug signing key (generated locally / in CI via keytool, never committed)
android/debug.keystore
android/build/local.properties
# .import folder contains imported assets (stex, etc) - generated but large
.import/
# Allow tracking of Qodot .map import artifacts for CI cold-export
!.import/*.map-*.md5
!.import/*.map-*.tres
*.stex
# Note: *.import files are now tracked for Colab compatibility

# Test snapshots are generated artifacts and should not be committed by default.
core_v2/tests/*.json

.vscode/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*

# Game specific
replays/
reports/
test_output/

pupeteer/.venv/
*.pyc
*/__pycache__/
digest.txt
.venv311/
.claude/

# Environment secrets
.env

# Telemetry runtime artifacts (regenerated, not source)
*.log
data/ghosts.db
.venv/
.vercel
