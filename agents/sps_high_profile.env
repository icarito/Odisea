# High-SPS runtime profile for ANNA RL on godot3-server.
# Source this file before launching training/eval scripts.
#
# Usage:
#   set -a
#   source agents/sps_high_profile.env
#   set +a

GODOT_BIN=godot3-server
ANNA_GODOT_PREFER_SERVER=1
ANNA_GODOT_SERVER_FALLBACK=0
ANNA_GODOT_DISABLE_RENDER_LOOP=1
# Keep empty: do not force --video-driver on godot3-server.
ANNA_GODOT_SERVER_VIDEO_DRIVER=
ANNA_GODOT_QUIET=1
ANNA_GODOT_DISABLE_AUDIO_DRIVER_FLAG=1

# Keep unset/empty: --max-fps 0 can reduce throughput on godot3-server.
ANNA_GODOT_MAX_FPS=

ANNA_RL_BINARY_PROTOCOL=1
ANNA_RL_DISABLE_CPU_SLEEP=1
ANNA_RL_POLL_SLEEP_USEC=0
ANNA_RL_DISABLE_QODOT=1

# Stable high-throughput defaults found in local benchmarks.
ANNA_RL_PHYSICS_FPS=6000
ANNA_RL_TARGET_FPS=6000
ANNA_RL_PHYSICS_FPS_CAP=6000
ANNA_RL_MAX_PHYSICS_STEPS_PER_FRAME=64
