TEST_SCENE core_v2/levels/TestScene_AcrobaticJump.tscn

# 1. Start moving forward
INPUT_MOVE 0 -1.0
WAIT 1.0

# 2. SNAP BACKWARD (Input: Down)
INPUT_MOVE 0 1.0
WAIT 0.05

# 3. JUMP within window
INPUT_JUMP
WAIT 0.5

