[gd_resource type="Environment" format=2]

; Environment del Dome_Intro (domo de criogenia, 88 m de diametro, 34 m de alto).
;
; Intencion: aire frio y azulado que se acumula en altura, para que la torre
; central se lea por capas y el fuego/humo de la escena aporte el contraste
; calido. El fog de altura es lo que da la sensacion de volumen del domo.
;
; GLES2: sin SSAO (no lo soporta de forma util) y glow acotado a pocos niveles.

[resource]
background_mode = 1
background_color = Color( 0.008, 0.011, 0.022, 1 )
ambient_light_color = Color( 0.19, 0.2, 0.24, 1 )
ambient_light_energy = 0.55
ambient_light_sky_contribution = 0.0
fog_enabled = true
fog_color = Color( 0.05, 0.075, 0.12, 1 )
fog_sun_color = Color( 0.6, 0.32, 0.14, 1 )
fog_sun_amount = 0.25
fog_depth_begin = 12.0
fog_depth_end = 130.0
fog_depth_curve = 1.6
fog_transmit_enabled = true
fog_transmit_curve = 1.4
fog_height_enabled = true
fog_height_min = 26.0
fog_height_max = 2.0
fog_height_curve = 0.7
tonemap_mode = 2
tonemap_exposure = 0.95
tonemap_white = 2.0
glow_enabled = true
glow_levels/1 = false
glow_levels/2 = true
glow_levels/3 = true
glow_levels/4 = true
glow_levels/5 = false
glow_intensity = 0.9
glow_strength = 0.6
glow_bloom = 0.12
glow_blend_mode = 0
glow_hdr_threshold = 1.15
glow_hdr_luminance_cap = 5.0
glow_bicubic_upscale = true
adjustment_enabled = true
adjustment_brightness = 1.02
adjustment_contrast = 1.14
adjustment_saturation = 1.02
