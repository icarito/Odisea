{
    "chat.mcp.serverSampling": {
        "src/.vscode/mcp.json: mcp-godot": {
            "allowedModels": []
        }
    },
    "godotTools.editorPath.godot3": "/usr/bin/godot3-bin",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestArgs": [
        "tests/test_odisea_runner.py",
        "tests/test_stress_profile.py",
        "--odisea-runner=gdunit",
        "--odisea-editor",
        "--odisea-include-determinism",
        "-n",
        "6"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    "files.associations": {
        "*.oys": "gdscript"
    },
    "godotTools.sceneFileExtensions": [
        ".tscn",
        ".oys"
    ]
}
