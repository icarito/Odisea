; Piso de RingHub — variante MOBILE/FLAT (liviana).
; Misma textura albedo y mismas UV1 que la version desktop, sin normal/rough/ao.
; En el handheld el tier LOW corre ODISEA_UNSHADED=2: GLES3VendorGate deja los
; SpatialMaterial unshaded conservando el albedo, asi que esta variante se ve
; igual de texturada pero no carga ni samplea los mapas extra. albedo_color algo
; mas claro porque sin luz horneada la difusa no recibe aporte del ambiente.
[resource]
resource_name = "M_RingHubFloor_mobile"
albedo_color = Color( 0.85, 0.89, 0.93, 1 )
albedo_texture = ExtResource( 1 )
metallic = 0.0
roughness = 1.0
uv1_scale = Vector3( 0.5, 0.5, 0.5 )
