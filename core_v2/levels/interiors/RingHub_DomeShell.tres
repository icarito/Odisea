[gd_resource type="SpatialMaterial" load_steps=5 format=2]

[ext_resource path="res://assets/textures/Hangar Concrete Floor/1k/textures/hangar_concrete_floor_diff_1k.png" type="Texture" id=1]
[ext_resource path="res://assets/textures/Hangar Concrete Floor/1k/textures/hangar_concrete_floor_nor_gl_1k.png" type="Texture" id=2]
[ext_resource path="res://assets/textures/Hangar Concrete Floor/1k/textures/hangar_concrete_floor_rough_1k.png" type="Texture" id=3]
[ext_resource path="res://assets/textures/Hangar Concrete Floor/1k/textures/hangar_concrete_floor_ao_1k.png" type="Texture" id=4]

; O7: material propio de la cascara del domo de RingHub. El shell horneado
; (DomeInteriorLowPoly_baked.mesh, M_DomeInteriorLowPoly) traia un gris casi
; identico al piso, asi que pared y piso no se distinguian. Este override
; conserva el resto del look del shell (metallic 0, roughness 0.9, cull disabled
; para verse desde adentro) y le da un tono frio oscuro claramente distinto del
; piso, ahora con detalle barato: hormigon tiled (diff + normal + rough + ao) en
; las UV1 cilindricas que genera tools/bake_dome_interior_lowpoly.gd. El UV1
; recorre la vuelta completa en u (0..1) y la altura en v (0..1); uv1_scale
; (38, 6) deja paneles de ~5.8 m, cuadrados contra la circunferencia.
;
; Modo plano (low-end): el gate GLES3VendorGate deriva el color plano de ESTE
; material (material_override del nodo DomeMesh), no del gris claro embebido en
; la malla. albedo_color * promedio de la textura da el azulado oscuro que se ve
; en desktop. Si se cambia albedo_color aca, cambia tambien el flat/mobile.
[resource]
resource_name = "M_RingHubDomeShell"
params_cull_mode = 2
albedo_color = Color( 0.62, 0.74, 0.88, 1 )
albedo_texture = ExtResource( 1 )
metallic = 0.0
roughness = 0.9
roughness_texture = ExtResource( 3 )
normal_enabled = true
normal_scale = 1.0
normal_texture = ExtResource( 2 )
ao_enabled = true
ao_light_affect = 0.0
ao_texture = ExtResource( 4 )
ao_on_uv2 = false
ao_texture_channel = 0
uv1_scale = Vector3( 38, 6, 1 )
