[gd_scene load_steps=8 format=2]

; Reventon de criorrefrigerante (reemplaza a explosion_03, la bola de fuego naranja).
; Criterios: barato y legible desde lejos.
;   - Sin OmniLight. La del prefab viejo, con sombras, costaba +264 draw calls por segundo
;     de fogonazo; incluso sin sombras una luz en GLES2 agrega un pase por objeto afectado.
;   - Todo unshaded: el vapor no necesita iluminacion, y asi se lee blanco contra el domo
;     oscuro a treinta metros.
;   - Dos capas: un frente de choque corto y brillante que marca el instante, y una pluma
;     radial que se expande y queda un segundo mas para que se pueda localizar el punto.

[ext_resource path="res://assets/flipbook_particles/assets/clouds/textures/cloud_01.tga" type="Texture" id=1]

