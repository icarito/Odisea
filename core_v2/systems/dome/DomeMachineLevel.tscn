[gd_scene load_steps=31 format=2]

; DomeMachineLevel.tscn — nivel de máquinas del domo: las 4 redes (criocoolant, plasma,
; energía, aire) autoradas en un solo sub-árbol, cableadas a DomeNetworkStatus/DomeSystemDirector
; (FD-289 §7.8, T6/T7). Se instancia dentro de Dome_Intro.tscn; las posiciones son coordenadas
; de mundo del domo (DomeMachineLevel se instancia sin transform).
;
; Redes:
;   Criocoolant -> CoolantTank + CoolantFlowAdapter (rama "machine_level") + 2 fugas + 3 parches
;                  + 1 válvula aguas arriba.
;   Plasma      -> PlasmaConduit (fisura) + 3 válvulas de redirección + PlasmaRoute.
;   Energía     -> AuxPowerBus + interruptor principal + interruptor del bus + fusible.
;   Aire        -> PressureSection + PressurePump + PurgeDial + PurgeTuner.
;
; El cableado red->HEALTHY vive en DomeNetworkWiring.gd: acá sólo se declaran las conexiones.

[ext_resource path="res://core_v2/systems/dome/DomeNetworkStatus.gd" type="Script" id=1]
