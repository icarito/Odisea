margin_bottom = -186.0
custom_constants/margin_right = 8
custom_constants/margin_left = 8

[node name="VBox" type="VBoxContainer" parent="TelemetryPanel/TextArea"]
custom_constants/separation = 14

[node name="Title" type="Label" parent="TelemetryPanel/TextArea/VBox"]
text = "QUE NOS ENVIA ODISEA"
align = 1

[node name="Body" type="Label" parent="TelemetryPanel/TextArea/VBox"]
size_flags_vertical = 3
text = "Odisea puede enviar datos tecnicos anonimos durante la partida: cuantos cuadros por segundo alcanza el aparato, en que escena cae el rendimiento, y el detalle de un error si el juego falla.

Sirve para una sola cosa: encontrar donde el juego anda mal en aparatos reales, que es algo que no se ve desde una computadora de desarrollo. Esta misma pantalla existe por eso: la telemetria mostro cuanto tardaba en abrir el primer nivel en un telefono.

No se guarda nada personal: ni nombre, ni correo, ni ubicacion, ni lo que ocurre en la partida. La decision se puede cambiar cuando se quiera desde Opciones."
autowrap = true

