custom_constants/margin_right = 8
custom_constants/margin_left = 8

[node name="VBox" type="VBoxContainer" parent="TelemetryPanel/TextArea"]
custom_constants/separation = 14

[node name="Title" type="Label" parent="TelemetryPanel/TextArea/VBox"]
text = "AVISO DE PRIVACIDAD"
align = 1

[node name="Body" type="Label" parent="TelemetryPanel/TextArea/VBox"]
size_flags_vertical = 3
text = "Mientras juegas, Odisea puede enviarnos datos técnicos anónimos: los cuadros por segundo que alcanza tu equipo, la memoria que usa, en qué escena y en qué punto del mapa te encuentras, hacia dónde miras y el detalle de cualquier error.

Si el rendimiento cae durante varios segundos seguidos, se guarda además un fragmento breve de ese tramo —los controles que usaste y tu recorrido— para poder reproducirlo después y encontrar la causa.

El juego no envía tu ubicación. Como en cualquier conexión a internet, nuestro servidor ve tu dirección IP y de ella deduce una ciudad aproximada; la IP no se almacena tal cual. Nunca te pedimos ni guardamos tu nombre, tu correo ni ningún dato de contacto.

Puedes cambiar esta decisión cuando quieras desde Opciones."
autowrap = true

