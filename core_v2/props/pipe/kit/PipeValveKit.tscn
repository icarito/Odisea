[gd_scene load_steps=5 format=2]

; PipeValveKit — valvula del kit modular con la logica de PipeValve.gd.
;
; SIN rotacion interna: la pieza corre sobre +Y local desde su origen, que es la
; convencion del kit (pivote en la BASE). Las instancias en Dome_Intro traen la
; orientacion; antes yo compensaba con rotaciones aca adentro para reusar los
; transforms de la PipeValve vieja, y encadenar esas rotaciones fue la causa de que
; el prop apareciera desarmado varias veces.
;
; Escala x4 = el mismo factor que PipeRoute.grosor (kit Ø0.10 -> domo Ø0.40).
; PipeValve.gd busca `Wheel` y `StatusIndicator/StatusLight`, y gira Wheel.rotation.z.

[ext_resource path="res://core_v2/props/pipe/PipeValve.gd" type="Script" id=1]
[ext_resource path="res://core_v2/components/SFXComponentV2.gd" type="Script" id=7]
[ext_resource path="res://assets/sfx/metal2.wav" type="AudioStream" id=8]
[ext_resource path="res://core_v2/props/pipe/kit/PipeValveKit_body.mesh" type="ArrayMesh" id=9]
[ext_resource path="res://core_v2/props/pipe/kit/PipeValveKit_wheel.mesh" type="ArrayMesh" id=10]

