LEVEL res://core_v2/props/ElevatorTestScene.tscn
# Initial stabilization time for logic circuit to build
WAIT 2.0
SCREENSHOT 0_idle

# Press Floor 1
PRINT "Triggering Floor 1..."
INTERACT ElevatorProp/Button_Floor1
WAIT 5.0
SCREENSHOT 1_mid

# Press Internal Button (Floor 2)
PRINT "Triggering Internal Button..."
INTERACT ElevatorProp/Platform/Button_Internal
WAIT 5.0
SCREENSHOT 2_active

# Press Floor 0
PRINT "Triggering Floor 0..."
INTERACT ElevatorProp/Button_Floor0
WAIT 8.0
SCREENSHOT 3_off
