[ext_resource path="res://core_v2/props/helmet_view/hazard_tape/HazardTape.gd" type="Script" id=1]

[sub_resource type="Shader" id=3]
code = "
shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_disabled,diffuse_burley,specular_schlick_ggx,unshaded;
uniform vec4 color1 : hint_color = vec4(1.0, 0.5, 0.0, 1.0);
uniform vec4 color2 : hint_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float scroll_speed = 0.5;
uniform float pulse = 1.0;

void fragment() {
    // Slower, more rhythmic scrolling
    float stripe = step(0.5, fract((UV.x * 2.0 + UV.y - TIME * scroll_speed) * 3.0));
    vec4 c = mix(color1, color2, stripe);
    
    // Smooth pulse instead of chaotic glitch
    float alpha_pulse = mix(0.7, 1.0, 0.5 + 0.5 * sin(TIME * 2.0));
    
    ALBEDO = c.rgb * mix(0.8, 1.2, pulse * (0.5 + 0.5 * sin(TIME * 3.0)));
    ALPHA = alpha_pulse;
}
"

