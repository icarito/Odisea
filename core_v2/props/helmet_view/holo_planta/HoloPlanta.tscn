[ext_resource path="res://core_v2/props/helmet_view/holo_planta/holo_plant_tex.png" type="Texture" id=2]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, unshaded;

uniform sampler2D plant_texture : hint_albedo;
uniform vec4 albedo_color : hint_color = vec4(0.0, 1.0, 1.0, 1.0);
uniform float activation : hint_range(0.0, 1.0) = 1.0;
uniform float glitch_intensity : hint_range(0.0, 1.0) = 0.05;

float random(float t) {
    return fract(sin(t * 12.9898) * 43758.5453);
}

void fragment() {
    float time_snap = floor(TIME * 15.0);
    float glitch_offset = (random(time_snap) - 0.5) * glitch_intensity * activation;
    
    vec2 uv_glitch = UV;
    if (random(time_snap + UV.y) > 0.95) {
        uv_glitch.x += glitch_offset;
    }

    vec4 tex = texture(plant_texture, uv_glitch);
    
    // Masking
    float mask = max(tex.r, max(tex.g, tex.b));
    if (mask < 0.05) {
        discard;
    }

    // Technical Scanlines & Flicker
    float scanline = sin(UV.y * 50.0 + TIME * 2.5) * 0.1 + 0.9;
    float flicker = step(0.03, random(TIME)) * 0.2 + 0.8;
    
    ALBEDO = albedo_color.rgb * tex.rgb * scanline * flicker;
    ALPHA = albedo_color.a * mask * (0.2 + 0.8 * activation) * flicker;
}
"

