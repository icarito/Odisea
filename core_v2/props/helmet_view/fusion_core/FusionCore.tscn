[gd_scene load_steps=12 format=2]

[ext_resource path="res://core_v2/props/helmet_view/fusion_core/FusionCore.gd" type="Script" id=1]

[sub_resource type="Shader" id=10]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, unshaded;

uniform vec4 housing_color : hint_color = vec4(0.1, 0.1, 0.15, 1.0);
uniform vec4 glow_color : hint_color = vec4(0.0, 0.8, 1.0, 1.0);
uniform float charge_level : hint_range(0.0, 1.0) = 0.0;

void fragment() {
    // Vertical energy lines on the housing
    float lines = step(0.92, sin(UV.x * 40.0)) * 0.6;
    // Horizontal scan pulse
    float scan = smoothstep(0.03, 0.0, abs(fract(UV.y - TIME * 0.3 * charge_level) - 0.5)) * charge_level;
    
    vec3 base = housing_color.rgb;
    vec3 glow = glow_color.rgb * (lines * charge_level * 2.0 + scan * 3.0);
    ALBEDO = base + glow;
}
"

[sub_resource type="ShaderMaterial" id=11]
