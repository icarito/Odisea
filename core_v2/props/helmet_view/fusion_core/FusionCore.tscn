[sub_resource type="Shader" id=3]
code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_disabled, unshaded;

uniform vec4 color_full : hint_color = vec4(0.0, 1.0, 1.0, 1.0);
uniform float charge_level : hint_range(0.0, 1.0) = 0.0;

void fragment() {
    vec2 center = UV - vec2(0.5);
    float dist = length(center);
    float angle = atan(center.y, center.x);
    
    // Plasma swirl
    float swirl = sin(angle * 3.0 + dist * 12.0 - TIME * 5.0 * charge_level) * 0.5 + 0.5;
    
    // Core glow - bright center falloff
    float core_glow = smoothstep(0.5, 0.0, dist);
    
    float energy = (swirl * 0.4 + core_glow * 1.5) * charge_level;
    
    ALBEDO = color_full.rgb * energy * 2.0;
    ALPHA = energy * charge_level;
}
"

