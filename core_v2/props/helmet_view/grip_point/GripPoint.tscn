[sub_resource type="Shader" id=3]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, unshaded;

uniform vec4 color_off : hint_color = vec4(0.2, 0.2, 0.25, 1.0);
uniform vec4 color_on : hint_color = vec4(1.0, 0.2, 0.0, 1.0);
uniform float activation : hint_range(0.0, 1.0) = 0.0;

void fragment() {
    // Vertical energy strips
    float strip = step(0.85, sin(UV.x * 25.0)) * 0.8;
    // Scrolling activation indicator
    float scroll = smoothstep(0.03, 0.0, abs(fract(UV.y + TIME * 1.5 * activation) - 0.5)) * activation;
    
    vec3 col = mix(color_off.rgb, color_on.rgb, activation);
    float glow = strip * activation + scroll * 2.0;
    
    ALBEDO = col * (0.4 + glow * 1.5);
}
"

