[sub_resource type="Shader" id=3]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, unshaded;

uniform vec4 color_stable : hint_color = vec4(0.0, 1.0, 1.0, 1.0);
uniform vec4 color_unstable : hint_color = vec4(1.0, 0.4, 0.0, 1.0);
uniform float stability : hint_range(0.0, 1.0) = 0.0;

void fragment() {
    vec2 center = UV - vec2(0.5);
    float dist = length(center);
    float angle = atan(center.y, center.x);
    
    // Rotating gravity field lines
    float field = sin(angle * 6.0 + TIME * 3.0 * stability) * 0.5 + 0.5;
    field *= smoothstep(0.5, 0.1, dist);
    
    // Pulsing core
    float core = smoothstep(0.15, 0.0, dist);
    float pulse = sin(TIME * 4.0) * 0.3 + 0.7;
    
    // Unstable flicker when low stability
    float flicker = mix(step(0.3, fract(sin(TIME * 20.0) * 43.0)), 1.0, stability);
    
    float energy = (field * 0.6 + core * pulse) * flicker;
    vec3 col = mix(color_unstable.rgb, color_stable.rgb, stability);
    
    ALBEDO = col * energy * 2.5;
    ALPHA = energy * (0.3 + 0.7 * stability);
}
"

