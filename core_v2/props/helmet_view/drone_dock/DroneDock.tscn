[sub_resource type="Shader" id=3]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, unshaded;

uniform vec4 ring_color : hint_color = vec4(0.0, 0.5, 1.0, 1.0);
uniform float activation : hint_range(0.0, 1.0) = 0.0;

void fragment() {
    // Rotating ring pattern
    vec2 center = UV - vec2(0.5);
    float dist = length(center);
    float angle = atan(center.y, center.x);
    
    // Concentric rings
    float ring = sin(dist * 30.0 - TIME * 2.0 * activation) * 0.5 + 0.5;
    ring = smoothstep(0.4, 0.6, ring);
    
    // Rotating segments
    float segments = step(0.5, fract((angle / 6.2832 + TIME * 0.5 * activation) * 4.0));
    
    // Inner landing circle
    float inner = smoothstep(0.15, 0.12, dist);
    
    // Outer ring mask
    float outer = smoothstep(0.5, 0.48, dist) * smoothstep(0.1, 0.12, dist);
    
    float pattern = max(inner * 0.5, outer * ring * segments);
    
    ALBEDO = ring_color.rgb * pattern * (0.3 + 0.7 * activation);
    ALPHA = pattern * (0.2 + 0.8 * activation);
}
"

