[ext_resource path="res://core_v2/Components/UI/InteractionMarker.gd" type="Script" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Control
var arcs := []
func _draw():
	for arc in arcs:
		_draw_arc_indicator(arc.pos, arc.angle, arc.color)

func _draw_arc_indicator(pos: Vector2, angle: float, color: Color) -> void:
	var radius := 24.0
	var thickness := 12.0
	var antialiased := true
	var start_angle := angle - PI/4.0
	var end_angle := angle + PI/4.0
	var points := 16
	var arc_points := PoolVector2Array()
	for i in range(points + 1):
		var a = start_angle + (end_angle - start_angle) * i / points
		arc_points.append(pos + Vector2(cos(a), sin(a)) * radius)
	draw_polyline(arc_points, color, thickness, antialiased)
"

