LEVEL res://core_v2/tests/TestScene_Cargol.tscn

// OYS_REQUIRE_RENDER: el pickup/visibilidad del Cargol depende del render; no desactivar en headless.
// Test: Basic Cargol Cargo Pickup and Movement
// This test verifies that Cargol can:
// 1. Move to a target position
// 2. Pick up cargo
// 3. Transport it to a new location
// 4. Release the cargo

SECTION "Cargo Transport Test"
    // Drone starts at (0, 5, 0)
    // Cargo starts at (5, 1, 0)
    
    // Move above cargo
    CALL CargolDrone "move_to" [5, 2, 0]
    WAIT 1.0
    
    // Pickup cargo
    CALL CargolDrone "pickup" "../Cargo"
    WAIT 0.2
    
    // Move back to origin area
    CALL CargolDrone "move_to" [0, 5, 0]
    WAIT 1.0
    
    // Release cargo
    CALL CargolDrone "release" [0, 0, 0]
    // El cargo es rigido y rueda tras el release; asertar a 0.2s lo pilla a mitad de
    // rodado y el resultado depende del motor (Bullet lo frena en x=-1.84, Box3D en
    // x=-2.66) y del timing. Dejarlo asentar antes de medir.
    WAIT 2.0
    
    // Verify results
    // Cargo should have moved from (5, 1, 0) to roughly (0, 5, 0) then released/fallen.
    
    // Check Cargo X position using helper to get value into variable
    SET $cargo_x GET_NODE_POS_X "Cargo"
    
    // Contrato funcional: el cargo dejo su spawn (x=5.0) y quedo cerca de la zona de
    // release. La banda cubre ambos motores de fisica con margen (Bullet -1.84,
    // Box3D -2.66 medidos); NO es un chequeo de determinismo -- de eso se encarga
    // test_determinism_v2 con sus DRIFT_CHECK.
    ASSERT $cargo_x < 3.0 "Cargo didn't move to target X (< 3.0)"
    ASSERT $cargo_x > -3.5 "Cargo rolled too far from release (> -3.5)"
    
    // Check Cargo moved from original spot (5.0)
    ASSERT $cargo_x < 4.0 "Cargo should have moved away from start (5.0)"

END
