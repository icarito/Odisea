SECTION "Reverse_Turn_Test"
    PRINT "Starting Tank Turn Reverse Test"
    
    # Tank turn: forward/backward and right are held on the same physics frames.
    # RIGHT with seconds means movement/strafe; no mouse_delta is injected here.
    BLEND 1.0
        FW 1.0s
        RIGHT 1.0s
    END
    WAIT 0.5
    SCREENSHOT "forward_right"
    PRINT "Tank turned right while moving forward"
    
    BLEND 1.0
        BW 1.0s
        RIGHT 1.0s
    END
    WAIT 0.5
    SCREENSHOT "backward_right"
    PRINT "Tank turned right while moving backward"
    
    PRINT "Test completed. Check results visually or via camera alignment."
END
