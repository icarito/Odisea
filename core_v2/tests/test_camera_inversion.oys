// Test: Camera Inversion Verification
// Verifies that LOCKED_VIEW input is correctly mapped to screen space

LEVEL res://core_v2/tests/TestCameraInversionPath.tscn

SECTION "Camera Movement Check"
    PRINT "Starting Camera Inversion OYS Test..."
    
    // Wait for physics loop stability
    WAIT 0.5

    // Assert Initial State
    ASSERT pos.x > -1.0 "Player should be near origin"
    
    // Test RIGHT Input (1, 0)
    // We want to verify that moving "Right" on stick moves "Right" on screen.
    // In TestCameraInversionPath, the camera is at (-6, 5, -17) looking at Player near (0,0,0).
    // The camera is looking roughly EAST. 
    // "Right" on screen should be SOUTH.
    
    PRINT "Inputting RIGHT..."
    INPUT 1.0 0.0
    
    WAIT 1.0
    
    VAR final_x = pos.x
    PRINT "Final X position:"
    PRINT final_x
    
    // With OLD mapping (Right = -1), X should DECREASE (West)
    ASSERT final_x < -2.0 "Player should have moved West (Standard Screen Right with old mapping)"
    
    PRINT "--- TEST CASE: LEFT (-1 on Stick) ---"
    INPUT LEFT 1.0
    WAIT 1.0
    // Should move back towards 0
    ASSERT pos.x > -1.0 "Player should have moved back East"
END
