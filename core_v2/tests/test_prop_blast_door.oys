// Test: HeavyBlastDoor interaction
// Verify door opens and player can pass through.

LEVEL res://core_v2/levels/TestPropsScene.tscn

SECTION "Open Blast Door"
    // Door is at (0, 0, -10)
    // Pilot starts at (0, 1, 0) facing -Z (usually)
    // Pilot usually spawns facing 0,0,-1 ? Need to verify rotation.
    // Assuming default look is forward (-Z).

    // Move close to door
    FW 8m

    // Interact
    INTERACT

    // Wait for animation (2.0s duration)
    WAIT 2.5

    // Walk through
    FW 4m

    // Verify position (should be past -10, e.g. -12)
    // If door didn't open, we would be blocked at approx -8.75 (door thickness)
    ASSERT pos.z < -11 "Failed to pass through blast door"
END
