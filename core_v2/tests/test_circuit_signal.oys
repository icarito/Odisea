LEVEL res://core_v2/tests/circuit_signal_test.tscn

# Test the CircuitCable propagation from Lever to CircuitCable and verify visual state transitions

SECTION "Setup" {
    SPAWN scene="res://core_v2/props/Lever.tscn" pos=[0, 0, 0]
    SPAWN scene="res://core_v2/systems/circuit/CircuitCable.tscn" pos=[3, 0, 0]
}

SECTION "Activate Lever" {
    # Simulate player interaction with the Lever
    INTERACT object="Lever"
    WAIT 0.5
    # Check CircuitCable enters "mid" state
    ASSERT $object["CircuitCable"].state == "mid"
}

SECTION "Deactivate Lever" {
    INTERACT object="Lever"
    WAIT 0.5
    # Check CircuitCable resets to "idle" state
    ASSERT $object["CircuitCable"].state == "idle"
}

END