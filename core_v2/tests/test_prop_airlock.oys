// Test: Airlock Cycling
// Verify sequence: Outer Open -> Enter -> Pressurize -> Inner Open -> Exit.

LEVEL res://core_v2/levels/TestPropsScene.tscn

SECTION "Airlock Cycle"
    // Airlock at (-15, 2, -10).
    // Start (0,1,0).

    // Face Left (-X).
    LEFT 90
    FW 15m
    // At (-15, 1, 0).

    // Face -Z (towards airlock).
    RIGHT 90
    // Airlock is at -10. Move to -8 (Outer Door).
    FW 8m

    // Interact Outer Door.
    INTERACT
    WAIT 2.0 // Door opens (anim duration)

    // Enter Chamber (-15, 1, -10).
    FW 2m

    // Door closes automatically on entry zone (phys process).
    // Wait for pressurize (1.0s) + reset (3.0s).
    WAIT 5.0

    // Inner door should be open now.
    // Inner door is at local -1.5 Z? No, Prefab:
    // OuterDoor at +1.5Z, Inner at -1.5Z relative to root.
    // Root is at Z=-10. So Outer at -8.5, Inner at -11.5.

    // We are at -10. Move to -13.
    FW 3m

    ASSERT pos.z < -12 "Failed to exit airlock"
END
