// Test: Destroyer Debug Test
// Verifies if Destroyer correctly cleans up props using signal assertions

LEVEL res://core_v2/levels/TestScene_PropEmitter.tscn

SECTION "Reproduce Destroyer Issue"
    PRINT "Starting destroyer signal test"
    
    // Wait for some props to spawn and fall
    WAIT 2.0
    
    // Check if player is alive
    ASSERT pos.y > -1.0 "Player fell"
    
    // We expect props to be destroyed if they touch the destroyer
    // The destroyer is at (0.18, 1.1, 18.8)
    // The emitter is at (0.18, 10.5, 18.7)
    // So props fall exactly into the destroyer.
    
    PRINT "Waiting for entity_destroyed signal..."
    
    // Use ASSERT_SIGNAL to verify the PropDestroyerArea emits entity_destroyed
    // Props should fall into the destroyer within 5 seconds
    ASSERT_SIGNAL "entity_destroyed" 5.0 "PropDestroyerArea"
    
    PRINT "SUCCESS: entity_destroyed signal was emitted!"
    
    WAIT 2.0
    
    // Verify player position is still stable
    ASSERT pos.y > -1.0 "Player should still be on ground"
    ASSERT pos.y < 3.0 "Player position unstable"
    
    PRINT "Test completed successfully"
END
