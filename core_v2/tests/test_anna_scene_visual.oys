# REQUIRE_ANNA=1
# OYS_NODET=1
LEVEL res://core_v2/tests/TestScene_ANNA.tscn

SECTION "ANNA Scene TCP Visual Validation"
    SET $start_z GET_NODE_POS_Z "Pilot"
    SET $start_yaw yaw_deg

    SET $anna_pid SYSTEM python3 core_v2/anna/client/anna_scene_visual_driver.py --frames 72 --move-y -1.0 --look-x 4.0
    ASSERT $anna_pid > 0 "ANNA python driver did not start"

    WAIT 1.4

    SET $end_z GET_NODE_POS_Z "Pilot"
    SET $end_yaw yaw_deg

    MATH $delta_z = $end_z - $start_z
    MATH $delta_yaw = $end_yaw - $start_yaw

    ASSERT $delta_z > 0.25 "Pilot did not move enough via ANNA TCP"
    ASSERT $delta_yaw != 0.0 "Pilot yaw did not change from ANNA look input"
    ASSERT pos.y > -1.0 "Pilot fell while running ANNA visual TCP test"
END
