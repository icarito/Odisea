LEVEL res://core_v2/levels/RingHub_Level.tscn
WAIT 2.0
GET_NODES_IN_GROUP "player" AS $players
LOG "RingHub players=$players"
GET_NODES_IN_GROUP "interactable" AS $interactables
LOG "RingHub interactables=$interactables"
SCREENSHOT "0_boot"
FW 0.65s
LEFT 15
FW 0.65s
LEFT 15
FW 0.65s
LEFT 15
FW 0.65s
LEFT 15
SCREENSHOT "1_walk_ring"
JUMP 0.2
WAIT 0.8
SCREENSHOT "2_jump"
INTERACT Criopod_Vert/RotatingObjectV2
WAIT 1.5
SCREENSHOT "3_pod_mid"
WAIT 2.0
SCREENSHOT "4_pod_open"
LOG "RingHub_Level OK"
QUIT
