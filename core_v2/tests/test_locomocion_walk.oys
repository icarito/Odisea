// test_locomocion_walk.oys
// Verifies that WALK FW is slower than FW

SET pos AS (0, 0, 0)
PRINT "Testing WALK speed..."

# Pass 1: WALK 1s
SET $start_z AS pos.z
WALK FW 1.0s
WAIT 0.5
SET $end_z_walk AS pos.z
MATH $dist_walk $start_z - $end_z_walk

PRINT "Walk Distance (1s): " + $dist_walk

// Expected move_speed = 5.0. In 1s, should be ~5m.
// If it was running (multiplier 1.8), it would be ~9m.
ASSERT $dist_walk > -4.0 "WALK failed to move slower than RUN"
ASSERT $dist_walk < -1.0 "WALK failed to move at base speed"

PRINT "Test passed!"
END
