// test_prop_turbine.oys
LEVEL res://core_v2/scenes/PropStage.tscn

SECTION "Turbine Activation"
    LOAD_PROP "res://core_v2/props/VentilationTurbine.tscn"

    // Initial position in PropStage: Pilot at (0, 1, 5). 
    // Turbine at (0, 0.5, 0). Faces Global -Z.
    // Wind (Local Z=5) blows Global +Z (towards pilot).
    
    // 1. Move into the wind overlap (Z=5 -> Z=2)
    FW 3.0m
    WAIT 0.5
    
    // Validate OFF state (No wind push)
    // We should be around Z=2.
    ASSERT pos.z < 2.5 "Turbine started ON (unexpected)"

    // 2. Place player in wind tunnel and activate Turbine
    SET pos (0, 0.5, 2)
    CALL method="set_active" args=[true]
    WAIT 2.0
    
    // Wind (5m/s) blows +Z. 
    // We were at Z=2. After 2s, we should be at Z > 10.
    ASSERT pos.z > 4.5 "Wind failed to push player back"
END
