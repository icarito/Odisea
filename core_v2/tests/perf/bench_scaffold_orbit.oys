# Benchmark: ScaffoldOrbit performance

LEVEL "res://core_v2/tests/TestScaffoldOrbit.tscn"

# Warmup
WAIT 3

# FASE 1: Forward
CALL perf_capture_start "scaffoldOrbit_fw"
FW 3s
CALL perf_capture_stop "scaffoldOrbit_fw"
WAIT 0.5

# FASE 2: Backward
CALL perf_capture_start "scaffoldOrbit_bw"
BW 3s
CALL perf_capture_stop "scaffoldOrbit_bw"
WAIT 0.5

# FASE 3: Strafe
CALL perf_capture_start "scaffoldOrbit_strafe"
FOR 3
    LEFT 1s
    RIGHT 1s
ENDFOR
CALL perf_capture_stop "scaffoldOrbit_strafe"
WAIT 0.5

# FASE 4: Rotación
CALL perf_capture_start "scaffoldOrbit_rotate"
FOR 4
    LEFT 90
    WAIT 0.2
ENDFOR
CALL perf_capture_stop "scaffoldOrbit_rotate"
WAIT 0.5

# FASE 5: Sprint + salto
CALL perf_capture_start "scaffoldOrbit_sprint"
RUN FW 1s
JUMP 0.5
WAIT 1
RUN FW 1s
JUMP 0.5
WAIT 1
CALL perf_capture_stop "scaffoldOrbit_sprint"
WAIT 0.5

# FASE 6: Idle
CALL perf_capture_start "scaffoldOrbit_idle"
WAIT 3
CALL perf_capture_stop "scaffoldOrbit_idle"

PRINT "=== SCAFFOLD_ORBIT BENCHMARK COMPLETE ==="
QUIT
END
