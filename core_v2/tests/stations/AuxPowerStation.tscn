[gd_scene load_steps=12 format=2]

; Estación de energía auxiliar (FD-259): puerta sellada + consola de respaldo
; (lever + lectura OD-02). La lógica del ciclo de energía vive en AuxPowerBus
; (core_v2/systems/auxpower/, aún no existe); esta escena solo la viste.
; Arranca "sin energía": la puerta cerrada y el OD-02 parpadeando con el
; contador propio del script (sin bus enchufado no hay nada más que mostrar).

[ext_resource path="res://core_v2/tests/stations/AuxPowerStation.gd" type="Script" id=1]
[ext_resource path="res://core_v2/props/doors/HeavyBlastDoor.tscn" type="PackedScene" id=2]
[ext_resource path="res://core_v2/props/controls/LeverV2.tscn" type="PackedScene" id=3]
