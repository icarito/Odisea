; Consola de purga delante de la esclusa: el aro blanco/rojo permite leer la
; presión antes de ver el efecto de chispa en el sello.
; Cartel del sector: dice qué se está mirando. Usa el SignagePanel configurable de FD-260,
; con autofit, así el texto entra sin calcular tamaños a mano.
; groups=["no_occlusion"]: un cartel es información, no un obstáculo. Sin esto el
; PropDitherManager le reemplaza su material por el de oclusión y el panel pierde el
; texto del viewport, quedando en el color plano del preset.
[node name="SectorSign" parent="." groups=[
"no_occlusion",
] instance=ExtResource( 22 )]
transform = Transform( -0.78, 0, -6.8e-08, 0, 0.78, 0, 6.8e-08, 0, -0.78, -2.15, 2.1, -0.45 )
text = "PRESION SECTOR 04"
color_preset = "warning"
text_color = Color( 1, 0.96, 0.88, 1 )
panel_alpha = 0.35
double_sided = true
alignment = 0
font = ExtResource( 23 )
font_size = 0
case_mode = 1
outline_size = 3
outline_color = Color( 0, 0, 0, 0.9 )
border_enabled = true
border_color = Color( 1, 0.53, 0, 1 )
border_width = 10.0
emission_energy = 1.8

