; Conducción de aire del sector: lo que la esclusa sella está acá adentro. Blanca, con el
; flujo corriendo despacio; cuando la presión sube, el caudal se acelera y arrancan las
; fugas de vapor por las juntas. La esclusa sola no dice "presión"; la cañería sí.
[node name="Pipes" type="Spatial" parent="."]
script = ExtResource( 9 )
flow_dir = Vector3( 0, 0, 1 )
flow_speed = 0.35
flow_intensity = 0.6
base_color = Color( 0.62, 0.66, 0.7, 1 )
flow_color = Color( 0.95, 0.97, 1, 1 )
noise_scale = 2.2
pipe_alpha = 1.0

