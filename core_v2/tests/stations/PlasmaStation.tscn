; Montadas contra la pared del caño, vástago hacia adentro (z negativo),
; volante despejado (mismo criterio que la válvula de CryoStation). Arrancan
; cerradas: el patrón roto por defecto.
[node name="ValveA" parent="." instance=ExtResource( 5 )]
transform = Transform( 1, 0, 0, 0, 1, 0, 0, 0, 1, -1.6, 1, 0.12 )

[node name="ValveB" parent="." instance=ExtResource( 5 )]
transform = Transform( 1, 0, 0, 0, 1, 0, 0, 0, 1, 1.6, 1, 0.12 )

; El punto de ruptura: el nozzle real del reactor, reescalado para leer como
; salida de una conducción rota y no como el motor completo. Su -Z local es
; la dirección del chorro; apunta hacia el jugador, que entra por -Z.
[node name="PlasmaExhaust" parent="." instance=ExtResource( 6 )]
transform = Transform( 0.46, 0, 0, 0, 0.46, 0, 0, 0, 0.46, 0, 1, 0 )

; Barrera de daño: el chorro cortando el paso frente a la ruptura. Arranca
; apagada; PlasmaStation.gd la prende recién cuando hay hazard real.
[node name="FireEmitter" parent="." instance=ExtResource( 7 )]
transform = Transform( 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.55, -1.3 )
visible = false
is_active = false
emission_radius = 0.28
particles_per_second = 1

[node name="FireSound" parent="FireEmitter"]
unit_db = -80.0
