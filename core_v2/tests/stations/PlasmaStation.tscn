; Mismo atlas que el núcleo, pero como SpatialMaterial: un ShaderMaterial no hace
; billboard, así que de costado las partículas se veían como láminas planas. El modo
; billboard de partículas (3) las mantiene siempre de cara, y el flipbook se anima con
; particles_anim_* + anim_offset_random, igual que en CryoVent_C.
[sub_resource type="SpatialMaterial" id=5]
resource_local_to_scene = true
flags_transparent = true
flags_unshaded = true
vertex_color_use_as_albedo = true
params_blend_mode = 1
params_billboard_mode = 3
params_billboard_keep_scale = false
particles_anim_h_frames = 8
particles_anim_v_frames = 8
particles_anim_loop = true
albedo_color = Color( 0.72, 0.5, 1, 0.6 )
albedo_texture = ExtResource( 11 )

