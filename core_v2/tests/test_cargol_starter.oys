LEVEL res://core_v2/tests/TestScene_Cargol.tscn

// ========================================
// CARGOL DRONE PROGRAMMING STARTER
// ========================================
// This is a template for programming Cargol, the cargo drone.
// Edit this file to create custom Cargol behaviors and tests.

// ========================================
// AVAILABLE CARGOL COMMANDS
// ========================================
//
// 1. MOVE TO POSITION:
//    CALL CargolDrone "move_to" [x, y, z]
//    Example: CALL CargolDrone "move_to" [10, 5, -3]
//
// 2. FOLLOW PATH:
//    CALL CargolDrone "follow_path" "NodePath/To/Path"
//    Example: CALL CargolDrone "follow_path" "../DronePath"
//
// 3. SET VELOCITY:
//    CALL CargolDrone "set_velocity" [x, y, z]
//    Example: CALL CargolDrone "set_velocity" [2, 0, -1]
//
// 4. STOP:
//    CALL CargolDrone "stop" []
//
// 5. PICKUP CARGO:
//    CALL CargolDrone "pickup" "NodePath/To/Cargo"
//    Example: CALL CargolDrone "pickup" "../Cargo"
//
// 6. RELEASE CARGO:
//    CALL CargolDrone "release" [impulse_x, impulse_y, impulse_z]
//    Example: CALL CargolDrone "release" [0, 0, 0]
//
// 7. QUERY CARGO STATUS:
//    CALL CargolDrone "query_cargo" []
//
// ========================================
// SCENE SETUP
// ========================================
// TestScene_Cargol.tscn contains:
// - CargolDrone at position (0, 5, 0)
// - Cargo (RigidBody) at position (5, 1, 0)
// - You can add more objects in the scene file
//
// ========================================


SECTION "Custom Cargol Program"
    // 1. Move to cargo location (above it)
    CALL CargolDrone "move_to" [5, 2, 0]
    WAIT 2.0

    // 2. Pick up the cargo
    // Note: The drone must be close enough to the cargo object.
    CALL CargolDrone "pickup" "../Cargo"
    WAIT 1.0

    // 3. Move to a new location with the cargo
    // Let's bring it back to the center and up high
    CALL CargolDrone "move_to" [0, 8, 0]
    WAIT 3.0

    // 4. Release the cargo
    // Applying a small forward impulse [0, 0, -2]
    CALL CargolDrone "release" [0, 0, -2]
    WAIT 2.0
    
    // 5. Return to home position
    CALL CargolDrone "move_to" [0, 5, 0]
    WAIT 2.0
END
