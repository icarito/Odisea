// Test: KillZone Signal Verification
// Verifies that KillZoneV2 correctly emits the player_killed signal

LEVEL res://core_v2/levels/TestScene_KillZone.tscn

SECTION "Respawn InputProviderTest"
    
    SET $start_Z GET_NODE_POS_Z "Pilot"

    // Move forward toward the gap in the floor
    // The floor is at z=0-10, gap at z=10-15, killzone at y=-5
    FORWARD 2.0

    SET $moved_Z GET_NODE_POS_Z "Pilot"
    PRINT "Moved to $moved_Z"
    // ASSERT $moved_Z > 10 "Player should have moved past the floor"
    
    PRINT "Moving player to fall into killzone..."
    
    WAIT 1

    // Move forward toward the gap in the floor
    // The floor is at z=0-10, gap at z=10-15, killzone at y=-5
    FORWARD 2.0
    
    SET $moved_Z2 GET_NODE_POS_Z "Pilot"
    PRINT "Moved to $moved_Z2"
    // ASSERT "$moved_Z2 > 0" "Player should have moved after respawn"
    
    PRINT "Moving player to fall into killzone..."
    
    // Now wait for the player_killed signal to be emitted
    // The KillZoneV2 is at y=-5, player will fall and trigger it
    
    WAIT 1

    
    // Move forward toward the gap in the floor
    // The floor is at z=0-10, gap at z=10-15, killzone at y=-5
    FORWARD 0.3
    
    SET $final_Z GET_NODE_POS_Z "Pilot"
    PRINT "Finally moved to $final_Z"
    ASSERT $final_Z > 0 "Player should have moved after respawn"
    
    
    // Guarda la posición final en X del jugador
    SET $end_z GET_NODE_POS_Z "Pilot"
    
    SET $delta_z $end_z
    MATH $delta_z - $start_z
    PRINT "Delta z: $delta_z"
    PRINT "Debería haberse movido después del respawn"
    // Verifica que el jugador se movió
    ASSERT $delta_z > 0
    
END
