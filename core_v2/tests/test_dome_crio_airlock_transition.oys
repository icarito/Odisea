LEVEL res://core_v2/levels/interiors/Dome_Crio.tscn

SECTION "Dome Crio Airlock To Exterior"
    WAIT 1.5

    // Position player at north airlock entry.
    SET_POS "Pilot" [-0.4, 4.4, -29.8]
    WAIT 0.5
    SET $yaw yaw_deg
    SET $pitch pitch_deg
    PRINT "Start yaw=$yaw pitch=$pitch"
    SCREENSHOT "00_north_airlock_entry"

    // Move through the north chamber using absolute positions. The project uses
    // inverted Z conventions, so this avoids camera/input ambiguity.
    SET_POS "Pilot" [-0.4, 4.4, -33.2]
    WAIT 0.3
    SET $px pos.x
    SET $py pos.y
    SET $pz pos.z
    PRINT "Immediately post-walk: x=$px y=$py z=$pz"
    SCREENSHOT "01_post_walk"

    WAIT 0.4
    SET $px pos.x
    SET $py pos.y
    SET $pz pos.z
    SET $yaw yaw_deg
    SET $pitch pitch_deg
    PRINT "T+0.4s: x=$px y=$py z=$pz yaw=$yaw pitch=$pitch"
    SCREENSHOT "02_transition_moment"

    WAIT 0.5
    SET $px pos.x
    SET $py pos.y
    SET $pz pos.z
    SET $yaw yaw_deg
    SET $pitch pitch_deg
    PRINT "T+0.9s: x=$px y=$py z=$pz yaw=$yaw pitch=$pitch"
    SCREENSHOT "03_post_transition"

    WAIT 5.5
    SET $px pos.x
    SET $py pos.y
    SET $pz pos.z
    SET $yaw yaw_deg
    SET $pitch pitch_deg
    SET $scene current_scene_basename
    SET $anim animator_physics_active
    SET $ots ots_spring_length
    PRINT "T+settled: x=$px y=$py z=$pz yaw=$yaw pitch=$pitch"
    PRINT "Arrived scene=$scene animator_active=$anim ots=$ots"
    SCREENSHOT "04_settled"

    ASSERT $py > -5.0 "Player should remain valid after Dome_Crio -> exterior transition"

END
