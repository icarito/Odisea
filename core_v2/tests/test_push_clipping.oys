# TestPushClipping
# Verifies that Pilot hands do not clip into PushableBox when pushing
LEVEL res://core_v2/tests/TestPush.tscn

# Setup: Player is at 0,0,0. Box is at 0,0,-2.5 (Forward is -Z)
# Wait for physics to settle
RIGHT 90
LOOK +90
SET $drift_threshold AS 0.03

# Box is at 0.0, 1.0, -2.5 (2.5m ahead)
# Just move to engage

# Move for 3.5 seconds to ensure contact and push state
# Use BLEND to push AND check clipping simultaneously
BLEND 1.5
	LEFT 1.5m
	ASSERT_NO_HAND_CLIPPING PushableBox 0.05 MONITOR 0.75
END

WAIT 0.2

BLEND 1.5
	BW 1.5m
	ASSERT_NO_HAND_CLIPPING PushableBox 0.05 MONITOR 0.75
END

WAIT 0.2
