LEVEL res://core_v2/tests/TestZeroGravity.tscn

SECTION "Zero-g: Camera finds shoulder through mesh inversion"
	WAIT 0.5

	# Enter the zero-g zone.
	FW 1.4
	WAIT 0.5

	# Force close camera for clear OTS view.
	ZOOM -8.0 0.4
	WAIT 3.0

	# Measure camera relative to player BEFORE roll.
	SET $up_before CAMERA_REL_UP Pilot
	PRINT "Before roll: camera height (relative) = $up_before"

	# Roll 180 degrees. The mesh inverts, rig rotates.
	ROLL_RIGHT 180 2.0
	WAIT 1.5

	# Measure camera relative to player AFTER roll.
	SET $up_after CAMERA_REL_UP Pilot
	PRINT "After roll: camera height (relative) = $up_after"

	# TEST: Camera height should VARY (not stay the same).
	# The hierarchy rotated with the mesh, so the shoulder is at a different relative height.
	# We expect up_after to be different from up_before (and both positive, not at feet).
	ASSERT $up_before > 0.5 "Before roll: camera must be at shoulder (positive height)"
	ASSERT $up_after > 0.3 "After roll: camera must still be positive (not inverted to feet)"
	ASSERT $up_after < $up_before "After roll: camera height must VARY as mesh inverts (not invariant)"

	PRINT "SUCCESS: Camera offset de-rotated correctly! Offset varies with mesh inversion!"
END
