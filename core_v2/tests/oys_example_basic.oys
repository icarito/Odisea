// OYS Example: Basic Forward Walk and Jump
SET pos (0, 0, 0)

SECTION "Basic Walk and Jump"
    FW 2.0           // Walk forward for 2 seconds
    WAIT 0.2         // Small pause
    JUMP 0.3         // Jump, hold for 0.3s
    FW 1.0           // Continue walking forward
    ASSERT pos.z > 2 "Player did not move forward enough"
END
