# Prop Validator OYS Script — Prototyping Edition
# Usage: godot --path . res://core_v2/scenes/PropStage.tscn --no-window
# Env vars: OYS_PROP_PATH (required), OYS_QUICK_MODE (optional, "1" for fast check)

LEVEL res://core_v2/scenes/PropStage.tscn
WAIT 1.0

SECTION "Setup"
    IF $sys_env_prop_path == "" GOTO NoPropPath
    LOAD_PROP $sys_env_prop_path
    GOTO StartValidation

SECTION "NoPropPath"
    PRINT "ERROR: OYS_PROP_PATH not set. Pass prop path via environment."
    EXIT 1

SECTION "StartValidation"
    WAIT 1.0
    SCREENSHOT 0_idle

    # Check if prop has INTERACT capability
    # Static props (WarningBarrier, BrokenFloorPanel, etc.) just need idle validation
    IF $sys_env_quick_mode == "1" GOTO QuickMode

    # Full validation: idle → interact → mid → active → off
    INTERACT target=prop
    WAIT 2.0
    SCREENSHOT 1_mid

    WAIT 3.0
    SCREENSHOT 2_active

    INTERACT target=prop
    WAIT 1.0
    SCREENSHOT 3_off
    EXIT 0

SECTION "QuickMode"
    PRINT "Quick mode: idle-only validation"
    EXIT 0
