LEVEL res://core_v2/scenes/PropStage.tscn
WAIT 1.0

# --- Validation Sequence for VentilationTurbine ---
# In a real CI runner, $sys_env_prop_path would be used.
# Here we default to the real prop if no env var is set.

SECTION "Setup"
    IF $sys_env_prop_path == "" GOTO LoadDefault
    LOAD_PROP $sys_env_prop_path
    GOTO StartValidation

SECTION "LoadDefault"
    PRINT "No env prop path set, loading default: VentilationTurbine"
    LOAD_PROP "res://core_v2/props/VentilationTurbine.tscn"

SECTION "StartValidation"
    WAIT 1.0
    SCREENSHOT 0_idle
    
    # Trigger Activation
    # PropBaseV2 handles logic, visuals update automatically
    INTERACT target=prop
    # Increased waits to capture slower visual transitions (was 0.25)
    WAIT 0.6
    SCREENSHOT 1_mid
    
    # Give longer time for active visual effects to settle (was 0.6)
    WAIT 1.2
    SCREENSHOT 2_active
    
    # Optional: Deactivate
    INTERACT
    WAIT 1.0
    SCREENSHOT 3_off
    
