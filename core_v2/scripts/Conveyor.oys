LEVEL res://core_v2/scenes/PropStage.tscn
WAIT 1.0

SECTION "Setup"
    IF $sys_env_prop_path == "" GOTO LoadDefault
    LOAD_PROP $sys_env_prop_path
    GOTO StartValidation

SECTION "LoadDefault"
    LOAD_PROP "res://core_v2/props/Conveyor.tscn"

SECTION "StartValidation"
    WAIT 1.0
    CALL preview_ready_state
    WAIT 0.4
    SCREENSHOT 0_idle

    CALL preview_running_state
    WAIT 0.6
    SCREENSHOT 1_mid

    WAIT 0.8
    SCREENSHOT 2_active

    CALL preview_disabled_state
    WAIT 0.4
    SCREENSHOT 3_off
