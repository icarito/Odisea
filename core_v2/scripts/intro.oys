SECTION "Intro"
    PRINT "Iniciando intro..."
    
    SET_TIME_SCALE 0.5
    
    CINEMATIC
    
    RIGHT 140
    
    PLAY_ANIM "Confused"

    LOOK -130

    WAIT 0.2

    RIGHT 90
    
    SET_TIME_SCALE 0.6

    WAIT_ANIM "Confused"

    WAIT 5.0s

    LEFT 40

    LOOK 130

    TIME_SCALE 1.0

    PRINT "Intro terminado."

    INTERACTIVE