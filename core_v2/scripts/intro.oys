SECTION "Intro"
    PRINT "ACTO I"
    
    SET_TIME_SCALE 0.7
    
    CINEMATIC
    
    # VCamera: Start with far dramatic establishing shot
    PRINT "[VCAM] goto IntroFar"
    VCAMERA name="IntroFar" duration=1.4 mode="scene"

    WAIT 1.4
    
    PRINT "Elías, despierta..."
    PLAY_ANIM "Confused"
    
    # Restore legacy shake magnitude (pre-VCamera integration): amp=0.25, rot=5.0, freq=16
    VCAMERA_SHAKE translation="(0.25, 0.25, 0.0)" rotation="(0, 0, 5.0)" intensity=1.0 duration=1.0 frequency=16
    
    WAIT 1.0
    
    # Push in closer - transitioning to medium shot
    PRINT "[VCAM] blend IntroClose"
    VCAMERA_BLEND name="IntroClose" duration=0.9 mode="scene"

    WAIT 0.6
    
    PRINT "Algo está mal..."
    PLAY_SOUND "ExplosionMini"
    
    # Keep the same legacy shake magnitude for the impact beat
    VCAMERA_SHAKE translation="(0.25, 0.25, 0.0)" rotation="(0, 0, 5.0)" intensity=1.0 duration=1.0 frequency=16
    
    WAIT 1.0
    
    SET_TIME_SCALE 0.7
    
    WAIT_ANIM "Confused"
    
    # Final intimate close-up
    PRINT "[VCAM] blend IntroFinal"
    VCAMERA_BLEND name="IntroFinal" duration=1.1 mode="scene"

    WAIT 1.1
    
    SET_TIME_SCALE 1.0
    
    PRINT "¡¿qué pasó acá?!"
    
    WAIT 0.5
    
    # Return control to player camera
    PRINT "[VCAM] return"
    VCAMERA_RETURN duration=0.8
    
    INTERACTIVE
