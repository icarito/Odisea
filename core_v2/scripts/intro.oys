SECTION "Intro"
    PRINT "ACTO I"
    
    SET_TIME_SCALE 0.5
    
    CINEMATIC
    
    BLEND 4.0
        SHAKE duration=4.0 amp=0.25 freq=16 rot=5.0
        RIGHT 140 3.0
        LOOK -30 3.0
        ZOOM  -4.0 3.0
    END

    PRINT "Elías, despierta..."
    PLAY_ANIM "Confused"

    WAIT 2.0
    PRINT "Algo está mal..."
    PLAY_SOUND "ExplosionMini"
    SHAKE duration=2.0 amp=0.25 freq=16 rot=5.0
    
    BLEND 1.0
        ZOOM +4.0 1.0
        LOOK +20 1.0
        RIGHT 90 1.0
    END
    
    WAIT 1.0

    SET_TIME_SCALE 0.6

    WAIT_ANIM "Confused"

    BLEND 2.0
        LEFT 40 2.0
        LOOK 20 2.0
    END

    WAIT 2.0

    TIME_SCALE 1.0

    PRINT "¡¿qué pasó acá?!"

    INTERACTIVE