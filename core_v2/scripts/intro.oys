SECTION "Intro"
    PRINT "Iniciando intro..."
    
    SET_TIME_SCALE 0.5
    
    CINEMATIC
    
    BLEND 4.0
        RIGHT 140 3.0
        LOOK -30 1.0
    END
    
    PLAY_ANIM "Confused"

    WAIT 1.0

    RIGHT 90
    
    SET_TIME_SCALE 0.6

    WAIT_ANIM "Confused"

    BLEND 2.0
        LEFT 40 2.0
        LOOK 20 2.0
    END

    TIME_SCALE 1.0

    PRINT "Intro terminado."

    INTERACTIVE