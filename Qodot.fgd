@BaseClass = Target[
	target(string) : "targetname de la entidad a activar. Vacio = sin cablear."  : ""
]

@BaseClass = Targetname[
	targetname(string) : "Nombre de esta entidad. Otra entidad la cablea poniendo este nombre en su campo target."  : ""
]

@BaseClass color(255 255 40) = Light[
	_color(color255) : "Light color"  : "255 255 255"
	delay(choices) : "Attenuation"  = [
		1 : "Inverse distance falloff"
		2 : "Inverse distance squared"
		5 : "Inverse distance squared B"
		0 : "Linear falloff (Default)"
		4 : "Local minlight"
		3 : "No falloff"
	]
	light(integer) : "Brightness"  : 300
	mangle(string) : "Spotlight angle"  : "0.005 0 0"
	wait(integer) : "Fade distance multiplier"  : 1
]

