[layer_names]

3d_physics/layer_1="Entorno"
3d_physics/layer_2="Player"
3d_physics/layer_3="NPC-Friendly"
3d_physics/layer_4="NPC-Hostile"
3d_physics/layer_5="Trigger"
3d_physics/layer_6="Vehicle"

[physics]

3d/smooth_trimesh_collision=true
common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
quality/intended_usage/framebuffer_allocation.mobile=2
vram_compression/import_bptc=true
vram_compression/import_etc=true
vram_compression/import_pvrtc=true
quality/shadow_atlas/size=2048
quality/shadows/filter_mode=0
quality/reflections/high_quality_ggx=false
quality/shading/force_lambert_over_burley=true
quality/shading/force_blinn_over_ggx=true
batching/options/use_batching=false
batching/options/single_rect_fallback=true
batching/parameters/batch_buffer_size=32768
environment/default_clear_color=Color( 0.137255, 0.219608, 0.282353, 1 )
environment/default_environment="res://default_env.tres"
quality/filters/anisotropic_filtering_level=0
