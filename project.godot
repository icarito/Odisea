[application]

config/name="Odisea"
run/main_scene="res://scenes/Menu.tscn"
boot_splash/image="res://assets/splash.png"
boot_splash/use_filter=false
config/icon="res://assets/odisea_icon.png"
boot_splash/minimum_display_time=3

[autoload]

SessionManager="*res://core_v2/autoloads/SessionManager.gd"
PersistenceManager="*res://core_v2/autoloads/PersistenceManager.gd"
WallOcclusionManager="*res://core_v2/autoloads/WallOcclusionManager.gd"
CinematicManager="*res://core_v2/autoloads/CinematicManager.gd"

[debug]

keep_debug_server_open=true

[display]

window/size/width=640
window/size/height=480
window/size/fullscreen=true
window/size/test_width=1280
window/size/test_height=960
window/dpi/allow_hidpi=true
window/vsync/vsync_via_compositor=true
window/per_pixel_transparency/allowed=true
window/per_pixel_transparency/enabled=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/MultiMeshBatcher/plugin.cfg", "res://addons/csgtomeshinstance/plugin.cfg", "res://addons/gdUnit3/plugin.cfg", "res://addons/multimesh_scatter/plugin.cfg", "res://addons/odisea_gizmos/plugin.cfg", "res://addons/qodot/plugin.cfg", "res://addons/qol-camera/plugin.cfg" )

[gdunit3]

settings/test/test_root_folder="core_v2/tests"

[gui]

theme/custom="res://assets/themes/retro_scifi.tres"

