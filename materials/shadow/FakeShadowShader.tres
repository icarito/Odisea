[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded;

uniform float deform_factor : hint_range(0.0, 2.0) = 1.0;
uniform float uv_scale : hint_range(0.1, 5.0) = 1.0;
uniform float hardness : hint_range(0.0, 1.0) = 0.5;
uniform float texture_rotation : hint_range(0.0, 6.28) = 0.0;
uniform vec2 uv_offset = vec2(0.0);
uniform float opacity : hint_range(0.0, 1.0) = 1.0;
// O8/O8b/O8r: rim/filo alrededor del blob. Hace legible la sombra sobre pisos
// oscuros (el nucleo negro no se ve ahi) sin ensuciar los claros, donde el
// nucleo sigue mandando. rim_strength=0 recupera el look legacy (solo negro).
// rim_width (unidades de dist^2) chico = filo fino y denso; grande = banda ancha.
// O8r: el filo blanco se veia demasiado vistoso en el Anbernic; rim_color pasa a
// un gris suave y rim_strength a una intensidad discreta (contorno tenue, no halo).
uniform float rim_strength : hint_range(0.0, 1.0) = 0.35;
uniform float rim_width : hint_range(0.0, 0.3) = 0.05;
uniform vec3 rim_color = vec3(0.42, 0.44, 0.47);
// Dither (retícula halftone procedural, sin textura). En modo DARK el núcleo
// negro del blob no contrasta sobre un piso casi negro y la sombra deja de
// leerse; un patrón ordenado de puntos levemente claros sobre el área del blob
// le devuelve el contraste al ojo sin pases extra. dither_strength = intensidad
// del velo claro (0.0 = look legacy, sin dither); dither_scale = tamaño en
// píxeles de la celda del patrón (más chico = retícula más fina). El patrón es
// función de FRAGCOORD (espacio de pantalla), no del tiempo ni de rand: determinista.
uniform float dither_strength : hint_range(0.0, 1.0) = 0.15;
uniform float dither_scale : hint_range(0.5, 8.0) = 1.5;
// cue_only = 1.0 dibuja SOLO el aro dithered (apaga nucleo negro y filo solidos).
// Lo usa el cue que se superpone a la BlobShadow analitica de desktop en piso DARK:
// aporta la reticula de legibilidad sin duplicar el oscurecido ni ensuciar el piso
// claro. 0.0 = quad legacy normal (nucleo + filo).
// O8t2b: la ORIENTACION (yaw) la aplica GDScript rotando la basis del quad, no el
// shader: el ovalo/aro gira con el mesh del actor. El patron Bayer se queda en
// FRAGCOORD (espacio de pantalla) a proposito: celda pixel-stable, sin nadar ni
// moire con la camara, y determinista. No hay uniform de yaw: no hace falta.
uniform float cue_only : hint_range(0.0, 1.0) = 0.0;

// Bayer 4x4 fijo (mismo que prop_dither_occlusion): ~pocas ALU, sin textura, y
// con mod() queda en [0,4) así que no sufre la pérdida de precisión mediump de
// FRAGCOORD grande (las diagonales que arruinaban el IGN en Android GLES2).
float bayer4(vec2 p) {
	float x = mod(floor(p.x), 4.0);
	float y = mod(floor(p.y), 4.0);
	if (y < 1.0) return (x < 1.0 ? 0.0 : (x < 2.0 ? 8.0 : (x < 3.0 ? 2.0 : 10.0))) / 16.0;
	if (y < 2.0) return (x < 1.0 ? 12.0 : (x < 2.0 ? 4.0 : (x < 3.0 ? 14.0 : 6.0))) / 16.0;
	if (y < 3.0) return (x < 1.0 ? 3.0 : (x < 2.0 ? 11.0 : (x < 3.0 ? 1.0 : 9.0))) / 16.0;
	return (x < 1.0 ? 15.0 : (x < 2.0 ? 7.0 : (x < 3.0 ? 13.0 : 5.0))) / 16.0;
}

void fragment() {
	// Center UV
	vec2 uv = UV - 0.5;
	
	// Apply Sub-Pixel Offset (Smooth Sliding on Voxel Grid)
	// UVs are 0..1. offset is calculated in GDScript.
	// If player is +X from center, we want texture to be shifted.
	uv -= uv_offset;
	
	// Apply Rotation
	float s = sin(texture_rotation);
	float c = cos(texture_rotation);
	mat2 rot_mat = mat2(vec2(c, -s), vec2(s, c));
	uv = rot_mat * uv;
	
	// Apply Logic Scale (Radius Control)
	uv *= uv_scale;
	
	// 1. Oval Shape
	// Stretch one axis. Let's make it slightly wider on X (or Z in world).
	uv.x *= 0.6; // Stronger oval for visibility
	
	// 2. Height Deformation
	// Range: Air (Alpha=0) -> Ground (Alpha=1)
	// Air: Scale 4.0 (Small shadow)
	// Ground: Scale 0.8 (Wide Splat)
	float scale = mix(4.0, 0.8, COLOR.a); 
	uv *= scale;
	
	// Circular (Elliptical) gradient
	float dist_sq = dot(uv, uv); 
	
	// Soft Edge / Blur
	// dist_sq limit is 0.25 (0.5 radius squared)
	// We smoothstep around 0.25.
	// Hardness 1.0 = Sharp. Hardness 0.0 = Very Blurred.
	// We map hardness to a delta.
	float edge_width = (1.0 - hardness) * 0.2; // Max blur width 0.2
	float core = 1.0 - smoothstep(0.25 - edge_width, 0.25, dist_sq);
	
	// Rim: filo pegado al contorno del nucleo (dist_sq = 0.25). rim_width chico lo
	// mantiene fino y denso; con rim_strength=0 desaparece (look legacy solo negro).
	float rim_in = 0.25 - rim_width * 0.5;
	float rim_out = 0.25 + rim_width * 0.5;
	float rim = smoothstep(rim_in, 0.25, dist_sq)
		* (1.0 - smoothstep(0.25, max(rim_out, 0.2501), dist_sq));
	
	float a_core = core * COLOR.a * opacity * (1.0 - cue_only);
	float a_rim = rim * COLOR.a * opacity * rim_strength * (1.0 - cue_only);
	// Halftone dithered: Bayer 4x4 en espacio de pantalla (FRAGCOORD), ~50% de
	// los píxeles del blob reciben un velo claro tenue. Sólo dentro de la forma
	// (core) y proporcional a dither_strength (0.0 = legacy, sin dither). En piso
	// claro el núcleo negro (a_core) sigue mandando; en piso DARK el velo da la
	// retícula que el ojo detecta aunque el piso esté negro. Con cue_only=1 el velo
	// se aplica sobre el contorno (rim) y no sobre el núcleo, para superponerse a la
	// blob sin oscurecer.
	float dither_mask = mix(core, rim, cue_only);
	float bayer = bayer4(FRAGCOORD.xy / max(dither_scale, 0.5));
	float dither = step(bayer, 0.5);
	float a_dither = dither * dither_mask * COLOR.a * opacity * dither_strength;
	float a_light = a_rim + a_dither;
	ALBEDO = mix(vec3(0.0, 0.0, 0.0), rim_color, a_light / max(a_core + a_light, 0.0001));
	ALPHA = clamp(a_core + a_light, 0.0, 1.0); 
}
"

[resource]
shader = SubResource( 1 )
shader_param/deform_factor = 1.0
shader_param/uv_scale = 1.0
shader_param/hardness = 0.5
shader_param/texture_rotation = 0.0
shader_param/uv_offset = Vector2( 0, 0 )
shader_param/opacity = 1.0
shader_param/rim_strength = 0.35
shader_param/rim_width = 0.05
shader_param/rim_color = Vector3( 0.42, 0.44, 0.47 )
shader_param/dither_strength = 0.15
shader_param/dither_scale = 1.5
shader_param/cue_only = 0.0
